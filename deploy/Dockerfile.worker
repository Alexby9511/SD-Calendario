FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml .
COPY pkg ./pkg
COPY server ./server
COPY client ./client

COPY deploy/wheelhouse /wheelhouse
ARG PIP_ARGS="--timeout 60 --retries 10"
RUN pip install --no-cache-dir $PIP_ARGS --find-links=/wheelhouse -e .

COPY deploy/ray-worker.sh /usr/local/bin/ray-worker
RUN chmod +x /usr/local/bin/ray-worker

ENTRYPOINT ["/usr/local/bin/ray-worker"]
